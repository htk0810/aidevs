# ============================================================
# 1. 기본 LLM Provider
# ============================================================

# 단일 AI Agent 예제의 기본 Provider
# 허용 값: openai, gemini, ollama, gemma
LLM_PROVIDER=openai

# 09 통합 Orchestrator의 Supervisor가 사용할 Provider
SUPERVISOR_PROVIDER=openai

# Agent별 기본 Provider
# - openai: OpenAI Cloud API의 gpt-4.1-mini
# - gemini: Google Gemini Cloud API의 gemini-3.5-flash
# - ollama: Local Ollama Server에서 실행하는 llama3.2
# - gemma: 같은 Local Ollama Server에서 실행하는 gemma3:4b
# ollama와 gemma는 이 과정에서 Model 선택을 구분하는 논리 Provider 이름입니다.
WEATHER_AGENT_PROVIDER=gemini
PLACE_AGENT_PROVIDER=ollama
BUDGET_AGENT_PROVIDER=openai
ITINERARY_AGENT_PROVIDER=gemma

# ============================================================
# 2. Cloud LLM
# ============================================================

# OpenAI를 사용하는 Lab에서 필요합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini를 사용하는 Lab에서 필요합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ============================================================
# 3. Local LLM · Ollama
# ============================================================

# Llama와 Gemma는 같은 Ollama Server에서 서로 다른 Model로 실행됩니다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMMA_MODEL=gemma3:4b

# ============================================================
# 4. MCP Server
# ============================================================

# Host Python에서 실행하는 공통 MCP 주소입니다.
MCP_HOST=127.0.0.1
MCP_PORT=8010
MCP_URL=http://127.0.0.1:8010/mcp

# ============================================================
# 5. Backend와 Frontend
# ============================================================

# 09 배포 설정 검사에서 사용하는 Backend 주소입니다.
API_BASE_URL=http://127.0.0.1:8000

# 08 Streamlit Frontend가 호출하는 Multi-Agent Backend 주소입니다.
MULTI_AGENT_API_URL=http://127.0.0.1:8000

# ============================================================
# 6. PostgreSQL과 Redis
# ============================================================

# 공용 aidevs-pgvector Container를 최초 생성할 때 설정한 비밀번호와 같아야 합니다.
DATABASE_URL=postgresql://agent_user:agent_pwd@127.0.0.1:5433/agent_db

# Redis DB 0을 실행 상태·Cache·Queue에 사용합니다.
REDIS_URL=redis://127.0.0.1:6379/0

# ============================================================
# 7. Orchestration과 상태 보관 제한
# ============================================================

# 한 요청에서 실행할 수 있는 최대 Orchestration 단계입니다.
MAX_ORCHESTRATION_STEPS=8

# Redis에 저장한 Task 상태의 만료 시간입니다. 단위는 초입니다.
TASK_TTL_SECONDS=3600
