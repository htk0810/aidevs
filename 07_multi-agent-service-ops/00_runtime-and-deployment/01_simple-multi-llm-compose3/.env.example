OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# compose.full-stack.yml이 PostgreSQL Container를 만들 때 사용하는 정보
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_pwd
POSTGRES_DB=agent_db

# 기본 compose.yml의 Backend가 기존 공용 Container에 접속하는 주소
# Backend도 Container이므로 127.0.0.1 대신 host.docker.internal을 사용합니다.
DATABASE_URL=postgresql://agent_user:agent_pwd@host.docker.internal:5433/agent_db
REDIS_URL=redis://host.docker.internal:6379/0

# init_database.py처럼 Host Python에서 PostgreSQL에 접속할 때 사용합니다.
HOST_DATABASE_URL=postgresql://agent_user:agent_pwd@127.0.0.1:5433/agent_db

# 선택형 Local LLM Container
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# 설치된 Gemma 3 4B 모델을 사용합니다. (9B `gemma`보다 메모리 요구량이 낮습니다.)
GEMMA_MODEL=gemma3:4b

# compose.release.yml로 Registry 배포 Image를 받을 때 사용합니다.
# <REGISTRY_ACCOUNT>를 Docker Hub 또는 GitHub Container Registry 계정으로 바꾸세요.
BACKEND_IMAGE=<REGISTRY_ACCOUNT>/simple-multi-llm-backend:1.0.0
FRONTEND_IMAGE=<REGISTRY_ACCOUNT>/simple-multi-llm-frontend:1.0.0

# Frontend를 Docker가 아닌 Host에서 직접 실행할 때만 선택적으로 사용합니다.
# frontend/app.py의 기본값도 http://127.0.0.1:8000이므로 보통 설정하지 않아도 됩니다.
# Docker Compose에서는 이 값을 사용하지 않고 compose.yml이 Frontend Container에
# BACKEND_URL=http://backend:8000을 직접 전달합니다.
# BACKEND_URL=http://127.0.0.1:8000
